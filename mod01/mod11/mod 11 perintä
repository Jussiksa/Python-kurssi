# 1. Kantaluokka
class Elain:
    elainten_lkm = 0

    def __init__(self, nimi, paino, synt_aika):
        self.nimi = nimi
        self.paino = paino
        self.synt_aika = synt_aika
        Elain.elainten_lkm += 1

    def liiku(self):
        print(f"{self.nimi} liikkuu jotenkin johonkin..")

    def aantele(self):
        print(f"{self.nimi} päästää äänen.")

    def kaikki_tiedot(self):
        print(f"Nimi: {self.nimi}, paino: {self.paino/1000} kg, syntymäaika: {self.synt_aika}")


# 2. Väliluokka (perii Elain-luokan)
class Peto(Elain):
    def __init__(self, nimi, paino, synt_aika, on_metsastanyt=False):
        super().__init__(nimi, paino, synt_aika)
        self.on_metsastanyt = on_metsastanyt


# 3. Aliluokat (perivät Peto-luokan)
class Ilves(Peto):
    def kilju(self):
        print(f"Ilves nimeltä {self.nimi} kiljuu!")

    def kaikki_tiedot(self):
        print("\nIlves")
        super().kaikki_tiedot()


class Karhu(Peto):
    def __init__(self, nimi, paino, synt_aika, on_horroksessa=False, on_metsastanyt=False):
        super().__init__(nimi, paino, synt_aika, on_metsastanyt)
        self.on_horroksessa = on_horroksessa

    def karju(self):
        print(f"Karhu nimeltä {self.nimi} karjuu!")

    def liiku(self):
        print(f"Karhu {self.nimi} möyrii eteenpäin.")

    def kaikki_tiedot(self):
        print(f"\nKarhu, on talviunilla: {self.on_horroksessa}")
        super().kaikki_tiedot()


