class Yritys:
    def __init__(self, nimi):
        self.nimi = nimi
        self.hoitolat = []

    def lisaa_hoitola(self, hoitola):
        self.hoitolat.append(hoitola)

    def tulosta_hoitolat(self):
        print(f"Yritys {self.nimi} hallinnoi seuraavia hoitoloita:")
        for hoitola in self.hoitolat:
            print(f"  - {hoitola.nimi} (Asukkaita: {len(hoitola.koirat)} koiraa)")

    def anna_joululahja(self):
        print(f"\n=== {self.nimi}: Aloitetaan joululahjojen jakelu kaikissa toimipisteissä ===")
        for hoitola in self.hoitolat:
            hoitola.tervehdi_koiria()


